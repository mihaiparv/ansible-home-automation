[Unit]
Description=%i service with docker compose started after victoriametrics stack
Requires=docker.service
After=docker-compose-w1@victoriametrics.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/%i
ExecStartPre=/usr/bin/docker compose create
ExecStart=/usr/bin/docker compose start
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target